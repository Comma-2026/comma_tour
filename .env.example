# ─── Flask ───
FLASK_HOST=
FLASK_PORT=5000
FLASK_DEBUG=true

# ─── 로그인 토큰 서명 키 (길고 무작위한 값. 바뀌면 기존 토큰 전부 무효) ───
SECRET_KEY=여기에_길고_무작위한_문자열

# ─── LDAP (docker-compose의 OpenLDAP 기본값과 일치) ───
LDAP_MODE=
LDAP_HOST=localhost
LDAP_PORT=
LDAP_USE_SSL=false
LDAP_ADMIN_DN=cn=admin,dc=comma,dc=tour
LDAP_ADMIN_PASSWORD=admin
LDAP_BASE_DN=dc=comma,dc=tour
LDAP_USER_OU=ou=users,dc=comma,dc=tour

# ─── 한국관광공사 API ───
SPOT_MODE=real
TOUR_API_KEY=국문_관광정보_서비스키
TOUR_CONGESTION_API_KEY=방문자_예측_서비스키
TOUR_WELLNESS_API_KEY=웰니스_서비스키

# ─── 다이어리 저장 모드 ───
#   json  : diaries_data.json 파일 (DB 불필요, 기본)
#   mysql : MySQL DB (일기 내용 + 사진을 한 행에 저장)
DIARY_MODE=json

# ─── MySQL (DIARY_MODE=mysql 일 때만 사용. DB·테이블은 첫 요청 시 자동 생성) ───
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=본인_MySQL_비밀번호
MYSQL_DB=comma_tour

# ─── 기상청 API ───
KMA_API_KEY=기상청_단기예보_서비스키