# ─── Flask ───
FLASK_HOST=
FLASK_PORT=5000
FLASK_DEBUG=true

# ─── LDAP (docker-compose의 OpenLDAP 기본값과 일치) ───
LDAP_MODE=
LDAP_HOST=localhost
LDAP_PORT=
LDAP_USE_SSL=false
LDAP_ADMIN_DN=cn=admin,dc=comma,dc=tour
LDAP_ADMIN_PASSWORD=admin
LDAP_BASE_DN=dc=comma,dc=tour
LDAP_USER_OU=ou=users,dc=comma,dc=tour

# ─── 한국관광공사 API ───
SPOT_MODE=real
TOUR_API_KEY=국문_관광정보_서비스키
TOUR_CONGESTION_API_KEY=방문자_예측_서비스키
TOUR_WELLNESS_API_KEY=웰니스_서비스키

# ─── 기상청 API ───
KMA_API_KEY=기상청_단기예보_서비스키